# 复制为 .env 并按需修改
APP_ENV=development
# JWT 签名密钥：生产环境务必改成随机长字符串（如 `openssl rand -hex 32`）
SECRET_KEY=change-me-please-use-a-long-random-string
# AI API Key 独立加密密钥；留空时兼容使用 SECRET_KEY
DATA_ENCRYPTION_KEY=
# 令牌有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 本地 HTTP 保持 false；HTTPS 部署必须设为 true
SESSION_COOKIE_SECURE=false
APP_TIMEZONE=Asia/Shanghai

# 管理员账号（首次启动时自动创建；修改后重启不会覆盖已存在账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 数据库连接串。默认 SQLite（单文件，零配置）。
# 改用 Postgres 示例： postgresql+psycopg://user:pass@localhost:5432/baby
DATABASE_URL=sqlite:///./data/baby.db

# 上传文件保存目录
UPLOAD_DIR=./data/uploads

# 允许的跨域来源（逗号分隔）。同源部署时保持为空。
CORS_ORIGINS=

# 是否信任 X-Forwarded-For。仅在应用只接受可信反向代理请求时开启。
TRUST_PROXY_HEADERS=false

# 默认只允许 AI 访问公网 HTTPS；本地模型确有需要时显式开启。
AI_ALLOW_PRIVATE_BASE_URLS=false

# 上传大小上限（MB）：图片默认 10，视频默认 200
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200
MAX_UPLOAD_FILES=20
CHUNK_TTL_HOURS=24
MIN_UPLOAD_FREE_MB=512
MAX_IMAGE_PIXELS=100000000
MAX_VIDEO_DURATION_SECONDS=3600
MAX_VIDEO_PIXELS=8294400
MAX_VIDEO_FPS=60
MAX_CONCURRENT_UPLOADS=6
MAX_CONCURRENT_MEDIA_JOBS=2
MEDIA_PROBE_TIMEOUT_SECONDS=15
MEDIA_PROCESS_TIMEOUT_SECONDS=1800

# 完整备份与安全导入
BACKUP_DIR=./data/backups
BACKUP_RETENTION=2
MAX_IMPORT_MB=20
MAX_IMPORT_RECORDS=50000
AUTO_BACKUP_BEFORE_MIGRATION=true

# 可选：restic 加密异地备份（由根目录 docker-compose.yml 使用）
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
